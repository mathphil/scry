{
    "manifest_version": 2,
    "name": "Scry",
    "version": "0.1",

    "background": {
        "scripts": [ "background.js" ]
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": [ "content.js" ],
        "run_at": "document_idle"
    }],

    "permissions": [ "contextMenus",
                     "downloads" ]
}
  
  